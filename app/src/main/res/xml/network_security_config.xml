<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow campus academic portals that still serve over HTTP while keeping system CAs strict -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
